rules_version = '2';
// The browser never talks to Firestore: every read and write goes through /api (Admin SDK, which ignores these rules).
// So the rules deny everything - a visitor with the public Firebase config can not read or write any document
// (in particular users/{uid}.exp, which is the membership expiry).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
